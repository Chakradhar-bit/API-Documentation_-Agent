# ---- Backend ----
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# SQLite database file (created automatically)
ADA_DB_PATH=data/agent.db

# Local directory scanned by POST /api/scan (dev/demo fallback)
# ADA_SCAN_DIR=demo

# ---- GitHub ----
# Personal access token used when cloning repositories from webhooks (private repos)
GITHUB_TOKEN=

# Secret used to verify X-Hub-Signature-256 on incoming webhooks.
# Leave empty during local development (signature checks are skipped).
GITHUB_WEBHOOK_SECRET=

# Directory used to clone/update watched repositories
# ADA_CLONE_DIR=backend/clones

# ---- AI (optional) ----
# The app works fully WITHOUT these keys (deterministic analysis is used).
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
